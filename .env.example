# ==============================================================================
# Environment Variables & Secrets Template (Admin App)
# ==============================================================================
# Copy this file to '.env' for local development and fill in your actual credentials.
# Run app locally with: flutter run --dart-define-from-file=.env
# WARNING: NEVER commit '.env' or any production secret keys to version control!

# Base Server & Backend API URL
SERVER_URL=https://wicmn.alwaysdata.net/delever

# Google Maps API Key
GOOGLE_MAPS_API_KEY=

# App Secret Key
APP_SECRET_KEY=

# Mapbox Access Token (for live driver tracking)
MAPBOX_ACCESS_TOKEN=
